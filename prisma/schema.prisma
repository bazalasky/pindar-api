// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model Activity {
  id              Int           @id @default(autoincrement())
  activityType    Type
  liftActivity    LiftActivity?
  runActivity     RunActivity?
  date            DateTime      @db.Date
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  durationSeconds Int
  notes           String?
  bodyweight      Decimal? // lbs
  user            User          @relation(fields: [userId], references: [id])
  userId          Int
  source          String        @default("manual")
  externalId      String?
  rawPayload      Json?

  @@unique([source, externalId])
  @@index([userId, date])
}

model LiftActivity {
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId Int      @id
  sets       Set[]
}

model RunActivity {
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId Int      @id
  distance   Decimal? // miles
  elevation  Int      @default(0) // feet
  heartRate  Int? // bpm
}

model Exercise {
  id     Int    @id @default(autoincrement())
  userId Int
  user   User   @relation(fields: [userId], references: [id])
  name   String
  sets   Set[]

  @@unique([userId, name])
}

model Set {
  id             Int          @id @default(autoincrement())
  exercise       Exercise     @relation(fields: [exerciseId], references: [id])
  exerciseId     Int
  liftActivity   LiftActivity @relation(fields: [liftActivityId], references: [activityId], onDelete: Cascade)
  liftActivityId Int
  weight         Decimal? // lbs
  reps           Int          @default(1)
  rpe            Decimal?
  setNumber      Int

  @@unique([liftActivityId, setNumber])
}

model User {
  id         Int        @id @default(autoincrement())
  activities Activity[]
  name       String
  email      String     @unique
  password   String
  exercises  Exercise[]
}

enum Type {
  Lift
  Run
}
