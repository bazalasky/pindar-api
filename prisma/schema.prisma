// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  moduleFormat           = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Activity {
  id  Int @id @default(autoincrement()) 
  activityType Type
  liftActivity LiftActivity?
  RunActivity RunActivity?
  date DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  duration Decimal
  notes String?
  bodyweight Decimal
  user User @relation(fields: [userId], references: [id])
  userId Int
  source String
  externalId String?
  rawPayload Json?
  @@unique([source, externalId])
}

model LiftActivity {
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId Int @id
  sets Set[]
}

model RunActivity {
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId Int @id
  distance Decimal @default(0)
  pace Decimal @default(0)
  elevation Int @default(0)
  heartRate Int?
}

model Exercise {
  id  Int @id @default(autoincrement())
  name String
  sets Set[]
}

model Set {
  id  Int @id @default(autoincrement())
  exercise Exercise @relation(fields: [exerciseId], references: [id])
  exerciseId Int
  liftActivity LiftActivity @relation(fields: [liftActivityId], references: [activityId], onDelete: Cascade)
  liftActivityId Int
  weight Decimal?
  reps Int @default(1)
  rpe Int?
  order Int
}

model User {
  id Int @id @default(autoincrement())
  activities Activity[]
  name String
  email String @unique
  password String
}

enum Type {
  Lift
  Run
}